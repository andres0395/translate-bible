{
  "name": "translate-bible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:content": "node scripts/build-content-bundle.mjs",
    "predev": "node scripts/build-content-bundle.mjs",
    "prebuild": "node scripts/build-content-bundle.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:chapter": "node scripts/validate-chapter.mjs",
    "validate:chapter:fix": "node scripts/validate-chapter.mjs --fix",
    "buildCloudflare": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  },
  "packageManager": "pnpm@11.22.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
